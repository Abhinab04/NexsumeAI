{
  "name": "backend",
  "version": "1.0.0",
  "description": "Nexsume.ai backend",
  "license": "MIT",
  "main": "dist/index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "node --import=tsx --watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "biome check --write"
  },
  "dependencies": {
    "@clerk/express": "^2.1.61",
    "@google/genai": "^1.15.0",
    "@types/ejs": "^3.1.5",
    "cookie-parser": "^1.4.7",
    "cors": "2.8.5",
    "dotenv": "17.2.1",
    "ejs": "^6.0.1",
    "express": "5.1.0",
    "express-rate-limit": "8.0.1",
    "helmet": "8.1.0",
    "http-status-codes": "2.3.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.1",
    "mongoose": "^8.17.2",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.5",
    "pdf-parse": "^1.1.1",
    "pino": "9.9.0",
    "pino-http": "10.5.0",
    "serve-favicon": "^2.5.1",
    "tar": "^7.5.22",
    "ua-parser-js": "^2.0.4",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/serve-favicon": "^2.5.7",
    "pino-pretty": "13.1.1",
    "supertest": "7.1.4",
    "tsup": "8.5.0",
    "tsx": "4.20.4",
    "typescript": "5.9.2"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "outDir": "dist",
    "format": [
      "esm",
      "cjs"
    ],
    "target": "es2020",
    "sourcemap": true,
    "clean": true,
    "dts": true,
    "splitting": false,
    "skipNodeModulesBundle": true
  }
}
