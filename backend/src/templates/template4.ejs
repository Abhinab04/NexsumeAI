\documentclass[a4paper,12pt]{article}

\usepackage{url}
\usepackage{parskip} 	

\RequirePackage{color}
\RequirePackage{graphicx}
\usepackage[usenames,dvipsnames]{xcolor}
\usepackage[scale=0.9]{geometry}

\usepackage{tabularx}
\usepackage{enumitem}

\newcolumntype{C}{>{\centering\arraybackslash}X} 

\usepackage{supertabular}
\usepackage{tabularx}
\newlength{\fullcollw}
\setlength{\fullcollw}{0.47\textwidth}

\usepackage{titlesec}				
\usepackage{multicol}
\usepackage{multirow}

\titleformat{\section}{\Large\scshape\raggedright}{}{0em}{}[\titlerule]
\titlespacing{\section}{0pt}{10pt}{10pt}

\usepackage[unicode, draft=false]{hyperref}
\definecolor{linkcolour}{rgb}{0,0.2,0.6}
\hypersetup{colorlinks,breaklinks,urlcolor=linkcolour,linkcolor=linkcolour}

\newenvironment{jobshort}[2]
    {
    \begin{tabularx}{\linewidth}{@{}l X r@{}}
    \textbf{#1} & \hfill &  #2 \\[3.75pt]
    \end{tabularx}
    }
    {
    }

\newenvironment{joblong}[2]
    {
    \begin{tabularx}{\linewidth}{@{}l X r@{}}
    \textbf{#1} & \hfill &  #2 \\[3.75pt]
    \end{tabularx}
    \begin{minipage}[t]{\linewidth}
    \begin{itemize}[nosep,after=\strut, leftmargin=1em, itemsep=3pt,label=--]
    }
    {
    \end{itemize}
    \end{minipage}    
    }

\begin{document}

\pagestyle{empty} 

\begin{tabularx}{\linewidth}{@{} C @{}}
\Huge{<%- personalInfo.fullName %>} \\[7.5pt]
<% if (personalInfo.github) { %>
\href{<%- personalInfo.github %>}{GitHub} \ $|$ \ 
<% } %>
<% if (personalInfo.linkedin) { %>
\href{<%- personalInfo.linkedin %>}{LinkedIn} \ $|$ \ 
<% } %>
<% if (personalInfo.portfolio) { %>
\href{<%- personalInfo.portfolio %>}{Portfolio} \ $|$ \ 
<% } %>
\href{mailto:<%- personalInfo.email %>}{Email} \ $|$ \ 
\href{tel:<%- personalInfo.phone %>}{Mobile} \\
\end{tabularx}

<% if (summary) { %>
\section{Summary}
<%- summary %>
<% } %>

\section{Work Experience}

<% experience.forEach(function(exp) { %>
\begin{joblong}{<%- exp.role %> at <%- exp.company %>}{<%- exp.startDate %> - <%- exp.endDate %>}
<% exp.description.forEach(function(desc) { %>
\item <%- desc %>
<% }) %>
\end{joblong}
<% }) %>
  
\section{Projects}

<% projects.forEach(function(proj) { %>
\begin{tabularx}{\linewidth}{ @{}l r@{} }
\textbf{<%- proj.name %>} & \hfill <% if (proj.link) { %> \href{<%- proj.link %>}{Link to Demo} <% } %> \\[3.75pt]
\multicolumn{2}{@{}X@{}}{<%- proj.description.join(' ') %>}  \\
\end{tabularx}
<% }) %>

\section{Education}
\begin{tabularx}{\linewidth}{@{}l X@{}}	
<% education.forEach(function(edu) { %>
<%- edu.startDate %> - <%- edu.endDate %> & <%- edu.degree %> at \textbf{<%- edu.institution %>} \hfill <% if (edu.gpa) { %> \normalsize (GPA: <%- edu.gpa %>) <% } %> \\
<% }) %>
\end{tabularx}

\section{Skills}
\begin{tabularx}{\linewidth}{@{}l X@{}}
<% if (skills.languages && skills.languages.length > 0) { %>
Languages &  \normalsize{<%- skills.languages.join(', ') %>}\\
<% } %>
<% if (skills.frameworks && skills.frameworks.length > 0) { %>
Frameworks  &  \normalsize{<%- skills.frameworks.join(', ') %>}\\  
<% } %>
<% if (skills.tools && skills.tools.length > 0) { %>
Tools  &  \normalsize{<%- skills.tools.join(', ') %>}\\  
<% } %>
\end{tabularx}

\vfill
\center{\footnotesize Generated by Nexsume AI}

\end{document}
